# Base URL of the Kloudspot API (REST + Socket.IO). CORS is open on this host.
VITE_API_BASE_URL=https://hiring-dev.internal.kloudspot.com

# Optional test login that switches the app to demo mode (generated sample data + simulated live events).
# Leave empty to disable demo mode. Put real values only in .env.development.local (not committed, dev server only).
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
